# Copy to .env and adjust as needed. .env is gitignored.

# Postgres credentials used by the postgres container itself, and embedded
# below in DATABASE_URL.
POSTGRES_USER=scoutintel
POSTGRES_PASSWORD=scoutintel
POSTGRES_DB=scoutintel
# 5433, not 5432 — avoids silently colliding with a Postgres already
# running locally on the host (localhost:5432 resolves to whichever bind
# is more specific, which won't necessarily be the container's).
POSTGRES_PORT=5433

# Host port to expose Redis on. Unused by the app today (no caching yet) —
# provisioned now so infra doesn't need to change when caching is added.
REDIS_PORT=6379

# Host port the API is reachable on.
API_PORT=8000

# Host here is "postgres" — the docker-compose service name, resolved via
# the compose network. Running the API outside docker compose (e.g. `uvicorn`
# directly on your host) needs this changed to "localhost".
DATABASE_URL=postgresql://scoutintel:scoutintel@postgres:5432/scoutintel
